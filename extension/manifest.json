{
  "manifest_version": 3,
  "name": "Recall Capture",
  "version": "1.0.0",
  "description": "Capture LeetCode solve timing and feed your local Recall spaced-repetition model.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Recall Capture"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content/leetcode.js"],
      "run_at": "document_idle"
    }
  ]
}
